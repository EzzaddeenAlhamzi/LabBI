APP_NAME=LabBI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=labbi
DB_USERNAME=labbi
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail — env-based only (no hardcoded SMTP in code)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@labbi.local"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp — provider-independent gateway (mock in V1; no vendor hardcoding)
WHATSAPP_DRIVER=mock
