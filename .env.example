APP_NAME=LabBI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

# Production: APP_ENV=production and APP_DEBUG=false (never expose stack traces)
# FORCE_HTTPS=true behind TLS reverse proxy
FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_RETENTION_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=labbi
DB_USERNAME=labbi
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Production cookies: SESSION_SECURE_COOKIE=true SESSION_SAME_SITE=lax (or strict)

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log

# Mail — env-based only (no hardcoded SMTP secrets in code/UI)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@labbi.local"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp — provider-independent gateway (mock in V1; no vendor hardcoding)
WHATSAPP_DRIVER=mock

# Backup / restore (AC-22 / AC-23)
BACKUP_DISK=local
BACKUP_SCHEDULE=daily
BACKUP_SCHEDULE_TIME=02:15
BACKUP_RETENTION_DAYS=14
ALLOW_RESTORE_DRILL_IN_PRODUCTION=false

# Auth brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60

# Optional object storage for backups / files (leave empty for local private disk)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
